# Local documentation and tool state
/documentry/
/.idea/
/.kilo/
/.superpowers/

# Source data stays local; retain the empty directory in fresh clones.
/dataset/*
!/dataset/.gitkeep

# Environments, Python/tool caches, and build products
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
.coverage
.coverage.*
coverage.xml
htmlcov/
build/
dist/

# Credentials and machine settings
.env
.env.*
!.env.example
.streamlit/secrets.toml
*.pem
*.key

# Learned/exported models and local runtime databases
*.pt
*.pth
*.ckpt
*.onnx
*.sqlite3*

# Derived data, annotations, and caches; keep only the public label contract.
/workspace/**/*
!/workspace/**/
!/workspace/**/.gitkeep
!/workspace/annotations/label_schema.yaml

# Run outputs and evaluation artifacts remain local.
/experiments/**/*
!/experiments/**/
!/experiments/**/.gitkeep
/artifacts/**/*
!/artifacts/**/
!/artifacts/**/.gitkeep
!/artifacts/checkpoints/registry.json
# This small frozen record is required by ConvNeXt configuration and tests.
!/artifacts/verification/phase5_convnext_batch8_memory_failures.json
/logs/*
!/logs/.gitkeep

# Operating-system/editor leftovers
Thumbs.db
Desktop.ini
.DS_Store
*.swp
*.swo
*~
